# Copy to .env (never commit .env). Local development values.
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=batas
POSTGRES_USER=batas
POSTGRES_PASSWORD=batas-local-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional. Without it the app answers with the most relevant law passages (keyword search).
# With it: hybrid search (keywords + embeddings) and short answers written by Gemini, with
# citations checked. A key is free from Google AI Studio. Set it only here or in your host's
# dashboard, never in the repo.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Questions allowed per visitor IP per hour (protects the free API quota).
# QUESTIONS_PER_HOUR=30
# Passages retrieved per question.
# RETRIEVAL_TOP_K=6

# --- Hosting only (see docs/deploy.md); leave unset for local development ---
# One URL instead of the POSTGRES_* values above (e.g. Neon). Takes precedence when set.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DJANGO_HTTPS=true
# DJANGO_STATIC_MANIFEST=true
# Header with the real visitor IP, set by a proxy that overwrites it (rate limiting).
# CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
# DJANGO_LOG_LEVEL=INFO
# DJANGO_TIME_ZONE=Asia/Manila
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=
